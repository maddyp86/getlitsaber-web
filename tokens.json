{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "Litsaber Design Tokens",
    "version": "0.3.0",
    "source": "Figma file cuBHq4i5XibiqCyleuZFHO + Motion Design System reconciliation",
    "notes": "v0.3.0 hybrid palette: deep purple-black canvas, 3 decorative accents (cyan/magenta/purple), pink #EC5793 as the dedicated CTA/conversion color, purple-to-pink gradient. Supersedes the pure-black two-accent palette of v0.2.0."
  },

  "color": {
    "background": {
      "primary":  { "value": "#0A0518", "description": "Page background — deep purple-black, base canvas" },
      "elevated": { "value": "#110826", "description": "Raised surfaces — cards, modals (one step up from base)" },
      "raised":   { "value": "#1A0D33", "description": "Highest surfaces — nested cards, popovers" },
      "overlay":  { "value": "rgba(10, 5, 24, 0.85)", "description": "Modal backdrop overlay (age gate, promo popup)" }
    },
    "accent": {
      "cyan":             { "value": "#00E5FF", "description": "Primary accent — trust, highlights, hover borders, glow" },
      "cyan-alpha-10":    { "value": "rgba(0, 229, 255, 0.1)", "description": "Cyan tint for surfaces/button fills" },
      "cyan-alpha-50":    { "value": "rgba(0, 229, 255, 0.5)", "description": "Cyan glow effect" },
      "magenta":          { "value": "#EC5793", "description": "Secondary accent — used sparingly for contrast" },
      "magenta-alpha-10": { "value": "rgba(255, 0, 229, 0.1)", "description": "Magenta tint for surfaces" },
      "purple":           { "value": "#9D5FFF", "description": "Tertiary accent — gradient start, atmospheric pools, card hover borders" },
      "purple-alpha-10":  { "value": "rgba(157, 95, 255, 0.1)", "description": "Purple tint for surfaces" },
      "purple-alpha-50":  { "value": "rgba(157, 95, 255, 0.5)", "description": "Purple glow effect" }
    },
    "cta": {
      "DEFAULT":     { "value": "#EC5793", "description": "Primary CTA / conversion color (Add to Cart, Get Yours). The money color." },
      "alpha-10":    { "value": "rgba(236, 87, 147, 0.1)", "description": "Pink CTA tint for button background fill" },
      "alpha-40":    { "value": "rgba(236, 87, 147, 0.4)", "description": "Pink CTA glow at rest" },
      "alpha-70":    { "value": "rgba(236, 87, 147, 0.7)", "description": "Pink CTA glow on hover (powers up)" }
    },
    "text": {
      "primary":   { "value": "#F0F0F5", "description": "Main text on dark backgrounds" },
      "secondary": { "value": "#D3D3D3", "description": "Sub-headlines and supporting copy" },
      "muted":     { "value": "#888888", "description": "De-emphasized text, secondary borders" },
      "accent":    { "value": "#00E5FF", "description": "Cyan text for highlights and feature labels" }
    },
    "border": {
      "default": { "value": "#888888", "description": "Neutral border for secondary buttons" },
      "accent":  { "value": "#00E5FF", "description": "Cyan border for emphasized elements" },
      "cta":     { "value": "#EC5793", "description": "Pink border for primary CTA buttons" },
      "pill":    { "value": "#2D1C53", "description": "Deep purple border for spec pills" },
      "divider": { "value": "#252525", "description": "Full-width section divider rule" }
    },
    "surface": {
      "tint-cyan":    { "value": "rgba(0, 229, 255, 0.1)", "description": "Cyan-tinted surface" },
      "tint-purple":  { "value": "rgba(157, 95, 255, 0.1)", "description": "Purple-tinted surface" },
      "tint-cta":     { "value": "rgba(236, 87, 147, 0.1)", "description": "Pink CTA-tinted surface" },
      "tint-white":   { "value": "rgba(240, 240, 245, 0.1)", "description": "White-tinted surface for secondary buttons" },
      "card":         { "value": "#110826", "description": "Card backgrounds — matches background.elevated" },
      "card-deep":    { "value": "#120F2C", "description": "Deep fill for bundle/selector cards and radio button backgrounds" }
    },
    "semantic": {
      "verified": { "value": "#00E5FF", "description": "Verified buyer badge color" },
      "rating":   { "value": "#FFD700", "description": "Star rating fill color" },
      "discount": { "value": "#EC5793", "description": "Save $X badge — uses CTA pink to draw the eye" },
      "error":    { "value": "#F56565", "description": "Inline form error messages — muted red, distinct from CTA pink" }
    }
  },

  "font": {
    "family": {
      "display":  { "value": "'Stellar', sans-serif",     "description": "Hero headlines. Paid license held by Innovape — self-host via next/font/local" },
      "accent":   { "value": "'Monoton', sans-serif",     "description": "Single-word emphasis (e.g. 'NIGHT'). Free via Google Fonts" },
      "subhead":  { "value": "'Orbitron', sans-serif",    "description": "Section sub-headings. Free via Google Fonts" },
      "body":     { "value": "'Inter', sans-serif",       "description": "Body copy and prose. Free via Google Fonts" },
      "label":    { "value": "'Space Mono', monospace",   "description": "CTAs, eyebrows, spec pills, labels. Free via Google Fonts" }
    },
    "size": {
      "display-xl":     { "value": "125px" },
      "display-lg":     { "value": "115px" },
      "display-accent": { "value": "100px" },
      "h1":             { "value": "75px" },
      "h2":             { "value": "55px" },
      "h3":             { "value": "45px", "description": "Modal headlines, About page section heads" },
      "h4":             { "value": "30px", "description": "Card titles, mode names" },
      "subhead":        { "value": "22px" },
      "body":           { "value": "18px" },
      "body-sm":        { "value": "16px", "description": "Small body text — mobile narrative copy" },
      "label":          { "value": "16px" },
      "eyebrow":        { "value": "14px" },
      "stat-display":   { "value": "150px", "description": "Battery stats callout numbers ('4', '300')" }
    },
    "weight": {
      "regular": { "value": 400 },
      "bold":    { "value": 700 }
    }
  },

  "radius": {
    "none": { "value": "0" },
    "sm":   { "value": "4px",    "description": "Small UI elements" },
    "md":       { "value": "8px",    "description": "Form inputs, small cards" },
    "selector": { "value": "5px",   "description": "Style/bundle selector cards" },
    "pill": { "value": "20px",   "description": "Spec pills, badges" },
    "card": { "value": "16px",   "description": "Cards, image containers, modals" },
    "full": { "value": "9999px", "description": "Fully rounded — circles, capsules" }
  },

  "spacing": {
    "xs":        { "value": "5px" },
    "sm":        { "value": "10px" },
    "md":        { "value": "20px" },
    "lg":        { "value": "30px" },
    "xl":        { "value": "50px" },
    "2xl":       { "value": "70px" },
    "section-y": { "value": "150px", "description": "Vertical spacing between major page sections (desktop)" },
    "section-y-mobile": { "value": "80px", "description": "Vertical section spacing (mobile)" },
    "container": { "value": "70px",  "description": "Horizontal page padding (desktop)" },
    "container-mobile": { "value": "13px", "description": "Horizontal page padding (mobile)" }
  },

  "shadow": {
    "glow-white":   { "value": "0 0 100px rgba(240, 240, 245, 1)", "description": "Hero headline white glow" },
    "glow-cyan":    { "value": "0 0 50px rgba(0, 229, 255, 0.5)",   "description": "Cyan glow — sub-headlines, accent elements" },
    "glow-purple":  { "value": "0 0 50px rgba(157, 95, 255, 0.5)",  "description": "Purple glow — atmospheric accents" },
    "glow-cta":     { "value": "0 0 30px rgba(236, 87, 147, 0.4)",  "description": "Pink CTA glow at rest" },
    "glow-cta-hover":{ "value": "0 0 40px rgba(236, 87, 147, 0.7)", "description": "Pink CTA glow on hover (powers up)" },
    "modal":        { "value": "0 20px 60px rgba(0, 0, 0, 0.5)",    "description": "Modal elevation" },
    "drawer":       { "value": "-10px 0 40px rgba(0, 0, 0, 0.3)",   "description": "Cart drawer elevation (slides from right)" }
  },

  "gradient": {
    "hero-fade": {
      "value": "linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 1) 100%)",
      "description": "Hero image bottom-fade to pure black for seamless blend with hero device image"
    },
    "cta": {
      "value": "linear-gradient(90deg, #9D5FFF 0%, #EC5793 100%)",
      "description": "Purple-to-pink gradient — CTA accents, scroll progress bar, gradient text"
    },
    "cta-radial": {
      "value": "radial-gradient(circle, rgba(157, 95, 255, 0.15) 0%, rgba(236, 87, 147, 0.05) 60%, transparent 100%)",
      "description": "Atmospheric color pool — purple-to-pink radial for section backgrounds"
    },
    "stats-banner": {
      "value": "linear-gradient(135deg, #2EF1EB 0%, #3B37A5 100%)",
      "description": "Cyan-to-purple diagonal gradient — stats callout banner in Under The Hood section"
    }
  },

  "component": {
    "navbar-height": { "value": "90px" },
    "cart-drawer-width-desktop": { "value": "450px" },
    "cart-drawer-width-mobile":  { "value": "100vw" },
    "modal-age-gate-width": { "value": "448px" },
    "modal-promo-width":    { "value": "389px" },
    "container-max-width":  { "value": "1440px" }
  },

  "breakpoint": {
    "sm":  { "value": "640px" },
    "md":  { "value": "768px" },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" },
    "2xl": { "value": "1440px" }
  },

  "z-index": {
    "base":      { "value": 1 },
    "sticky":    { "value": 10,   "description": "Sticky sub-nav (Activate, Engineering pages)" },
    "navbar":    { "value": 50 },
    "drawer":    { "value": 100,  "description": "Cart drawer, mobile nav drawer" },
    "modal":     { "value": 200,  "description": "Floating promo popup" },
    "age-gate":  { "value": 300,  "description": "Age gate — must be above everything" },
    "toast":     { "value": 350,  "description": "Toast notifications — topmost layer, above age-gate" }
  }
}
