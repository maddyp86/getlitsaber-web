# Litsaber Web — Environment Variables Template
#
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`. Real production values live in the Vercel dashboard.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only.

# -----------------------------------------------------------------------------
# Shopify Storefront API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Admin API token — server-only. Used for webhook signature verification, etc.
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Reviews — ReviewInfra
# Docs: https://reviewinfra.dev | https://docs.reviewinfra.dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_REVIEWINFRA_STORE_ID=
NEXT_PUBLIC_REVIEWINFRA_WIDGET_URL=https://review-infra-api-production.up.railway.app/embed/widget.js

# Server-only. Used to POST orders to ReviewInfra for review-request automation.
REVIEWINFRA_API_KEY=
REVIEWINFRA_ORDERS_ENDPOINT=https://review-infra-api-production.up.railway.app/orders

# -----------------------------------------------------------------------------
# Analytics — PostHog
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# -----------------------------------------------------------------------------
# HubSpot — newsletter / wholesale / contact forms
# -----------------------------------------------------------------------------
# Server-only — used by the /api/subscribe route handler. Never expose to browser.
HUBSPOT_PORTAL_ID=244547358
HUBSPOT_FORM_GOLD=d499701a-eb43-4c0e-a6cd-b56a57a98433
HUBSPOT_FORM_GENERAL=2a41aa81-1b55-4bcd-97e5-b2b3fe23ee69
# Embed-form pattern (wholesale, contact pages — js.hsforms.net embeds)
NEXT_PUBLIC_HUBSPOT_WHOLESALE_FORM_ID=f4b0a43c-c1e0-4452-a5ce-48d36ae56f57
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=fb0f6c82-3f57-405e-a655-a722321fd93f
NEXT_PUBLIC_HUBSPOT_REGION=na2

# -----------------------------------------------------------------------------
# Supabase — events mirror for the production agent (Phase 5+)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Site config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://getlitsaber.com
NEXT_PUBLIC_SITE_NAME=Litsaber

# -----------------------------------------------------------------------------
# Age gate
# Locked behavior: first-visit cookie, 30-day duration, hard wall, EXIT → google.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AGE_GATE_COOKIE_NAME=litsaber_age_verified
NEXT_PUBLIC_AGE_GATE_COOKIE_MAX_AGE_DAYS=30
NEXT_PUBLIC_AGE_GATE_EXIT_URL=https://www.google.com

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Toggle the Festival Drop List email signup form
NEXT_PUBLIC_FEATURE_DROP_LIST=true

# Toggle the floating promo popup ($10 off)
NEXT_PUBLIC_FEATURE_PROMO_POPUP=false
